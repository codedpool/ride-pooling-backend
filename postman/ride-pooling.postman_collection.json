    {
      "name": "Get Cab by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/cabs/:cabId",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "cabs", ":cabId"],
          "variable": [
            {
              "key": "cabId",
              "value": "",
              "description": "Cab UUID"
            }
