        "body": {
          "mode": "raw",
          "raw": "{\n  \"lat\": 28.5565,\n  \"lon\": 77.1005\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/cabs/:cabId/location",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "cabs", ":cabId", "location"],
          "variable": [
            {
              "key": "cabId",
              "value": "",
              "description": "Cab UUID"
            }
          ]
        },
        "description": "Update current GPS location of a cab"
